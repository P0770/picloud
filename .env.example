# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env contient des secrets : il est exclu du dépôt par .gitignore.

# Dossier racine des données sur le SSD
DATA_DIR=/mnt/ssd

# Nextcloud
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DOMAIN=cloud.mondomaine.ch

# Jeton du tunnel Cloudflare (Zero Trust → Networks → Tunnels → votre tunnel)
TUNNEL_TOKEN=
